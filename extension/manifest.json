{
  "manifest_version": 3,
  "name": "AI Chat Bridge",
  "description": "Bridge to control ChatGPT / Gemini / Qwen tabs from a local WebSocket server (send prompts, read replies).",
  "version": "1.0.0",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "permissions": ["tabs", "debugger", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Chat Bridge"
  }
}
